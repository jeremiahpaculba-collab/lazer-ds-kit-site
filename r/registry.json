      "description": "Three picture cards with title, copy and a link, wrapping at a 280 floor. Kit Feature Row module.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "https://lazer-ds-kit-site.vercel.app/r/lazer-utils.json",
        "https://lazer-ds-kit-site.vercel.app/r/aspect-image.json"
      ],
      "files": [
        {
          "path": "registry/lazer/blocks/feature-row.tsx",
          "type": "registry:block",
          "target": "components/lazer/blocks/feature-row.tsx"
        }
      ]
    },
    {
      "name": "hero-section",
      "type": "registry:block",
      "title": "Hero Section \u00b7 Split",
      "description": "Announcement pill, H2 heading, supporting copy, two actions and a 3:2 picture; side by side from 1024. Kit Hero Section module.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "https://lazer-ds-kit-site.vercel.app/r/lazer-utils.json",
        "https://lazer-ds-kit-site.vercel.app/r/button.json",
        "https://lazer-ds-kit-site.vercel.app/r/badge.json",
        "https://lazer-ds-kit-site.vercel.app/r/aspect-image.json"
      ],
      "files": [
        {
          "path": "registry/lazer/blocks/hero-section.tsx",
          "type": "registry:block",
          "target": "components/lazer/blocks/hero-section.tsx"
        }
      ]
    }
  ]
}