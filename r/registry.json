      "description": "Locked ratio picture with the grey ratio placeholder. Kit Image / Aspect Ratio set.",
      "registryDependencies": [
        "https://lazer-ds-kit-site.vercel.app/r/lazer-utils.json",
        "https://lazer-ds-kit-site.vercel.app/r/lazer-tokens.json"
      ],
      "files": [
        {
          "path": "registry/lazer/ui/aspect-image.tsx",
          "type": "registry:ui",
          "target": "components/lazer/aspect-image.tsx"
        }
      ]
    },
    {
      "name": "feature-row",
      "type": "registry:block",
